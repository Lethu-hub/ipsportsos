# Copy to .env.local and fill in your Supabase project values.
# These keys are PUBLIC by design (they ship in the browser bundle).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Browser-safe Supabase key (preferred current name). Never use a service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-sb_publishable-key>
# Legacy alternative supported by the application:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-or-publishable-key>
